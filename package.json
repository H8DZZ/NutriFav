{
  "name": "nutrifav",
  "version": "1.0.0",
  "description": "Sistema de gestión clínica para consultorios de nutrición. Administra pacientes, citas, planes alimenticios y seguimiento antropométrico.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux --x64",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "nutricion",
    "clinica",
    "gestion",
    "electron",
    "app",
    "nutrifav",
    "healthcare",
    "pacientes"
  ],
  "author": "Adrian Ortega Tenorio <adriantenorio0000@gmail.com> (https://github.com/H8DZZ)",
  "contributors": [
    {
      "name": "Brayan Sanchez Trejo",
      "url": "https://github.com/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/H8DZZ/NutriFav"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "sqlite3": "^5.1.6"
  },
  "build": {
    "appId": "com.nutrifav.app",
    "productName": "NutriFav",
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
